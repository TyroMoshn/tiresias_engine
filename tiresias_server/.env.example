# ==============================================================================
# TIRESIAS Server - Environment Configuration Template
# Copy this file to .env before starting the server:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Administrator master key for privileged operations (database reset, audit, hot-reload).
# MUST be replaced with a long random secure token in production!
TIRESIAS_ADMIN_KEY=change_this_to_a_secure_random_token

# ------------------------------------------------------------------------------
# Network Configuration
# ------------------------------------------------------------------------------
# Uvicorn bind host: 127.0.0.1 for local dev, 0.0.0.0 to listen on all interfaces (VPS/LAN)
TIRESIAS_HOST=127.0.0.1

# Service port
TIRESIAS_PORT=8000

# Domain name for Caddy Reverse-Proxy (auto-HTTPS via Let's Encrypt / ZeroSSL)
# For local testing keep localhost. For VPS specify your domain (e.g. demo.duckdns.org or ip.sslip.io).
TIRESIAS_DOMAIN=localhost

# Allowed CORS origins (comma-separated).
# Browser extensions (moz-extension:// and chrome-extension://) are allowed automatically via REGEX.
# Note: if set to '*', allow_credentials will be disabled per the W3C Fetch standard.
TIRESIAS_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000
# TIRESIAS_CORS_ORIGIN_REGEX=^(moz-extension|chrome-extension)://.*$

# ------------------------------------------------------------------------------
# SQLite Backup & Retention
# ------------------------------------------------------------------------------
# TIRESIAS_BACKUP_DIR=./backups
# TIRESIAS_BACKUP_RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# Paths & Storage
# ------------------------------------------------------------------------------
# Root directory containing precomputed recommendation artifacts (mmaps, features, bitmaps).
# Relative path from tiresias_server directory or absolute path.
TIRESIAS_DATA_ROOT=../data

# Primary SQLite database for user profiles, reactions, and boards
TIRESIAS_DB_PATH=../data/tiresias_user.db

# SQLite database for telemetry logging and client errors
TIRESIAS_TELEMETRY_DB_PATH=../data/tiresias_telemetry.db

# Optional path to cold-start initial suppression rules file (JSON)
# Default: tiresias_server/data/initial_suppression.json or ../data/initial_suppression.json
# TIRESIAS_SUPPRESSION_CONFIG=../data/initial_suppression.json

# ------------------------------------------------------------------------------
# Resource Profiles & Performance
# ------------------------------------------------------------------------------
# Engine operational profile:
#   'performance' - for powerful PCs and servers (large candidate budgets, maximum accuracy)
#   'eco'         - for low-spec laptops, mini-PCs, and cheap VPS (low RAM and CPU footprint)
TIRESIAS_PROFILE=performance

# OpenMP thread limit for FAISS vector search:
#   0   - automatic (use all available CPU cores)
#   >=1 - hard limit on threads (recommended 2 for 'eco' mode)
TIRESIAS_FAISS_THREADS=0

# ------------------------------------------------------------------------------
# Fine-tuning candidate limits
# Automatically populated depending on TIRESIAS_PROFILE, but can be overridden:
# ------------------------------------------------------------------------------
# TIRESIAS_FAISS_TOP_K=300
# TIRESIAS_COLLAB_TOP_K=150
# TIRESIAS_POPULAR_TOP_K=100
# TIRESIAS_MAX_CANDIDATES=500
# TIRESIAS_DEFAULT_LIMIT=30
# TIRESIAS_MAX_LIMIT=100
