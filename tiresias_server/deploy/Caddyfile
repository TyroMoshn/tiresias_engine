# TIRESIAS Caddy Reverse-Proxy Configuration
# Automatic HTTPS via Let's Encrypt / ZeroSSL when TIRESIAS_DOMAIN is set to a public domain.
# Defaults to localhost for local testing.

{$TIRESIAS_DOMAIN:localhost} {
    # Response compression
    encode zstd gzip

    # Basic security headers
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"

    # Reverse proxy to FastAPI backend container
    reverse_proxy tiresias:8000 {
        header_up Host {host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
