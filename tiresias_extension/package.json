{
  "name": "tiresias-extension",
  "description": "Tiresias AI recommendation client for e926.net and e621.net",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "sign:firefox": "wxt build -b firefox && web-ext sign --source-dir .output/firefox-mv3 --channel unlisted",
    "lint:firefox": "wxt build -b firefox && web-ext lint --source-dir .output/firefox-mv3",
    "compile": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.20.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "web-ext": "^8.4.0",
    "wxt": "^0.21.4"
  },
  "webExt": {
    "lint": {
      "selfHosted": true
    }
  }
}
